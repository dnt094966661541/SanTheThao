<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             x:Class="SanTheThao.Views.AdminApplicationsPage"
             x:DataType="vm:AdminApplicationsViewModel"
             Title="Hồ sơ chủ sân">

    <CollectionView ItemsSource="{Binding Applications}" Margin="16,12,16,0">
        <CollectionView.EmptyView>
            <Label Text="Chưa có hồ sơ nào." Style="{StaticResource SubLabel}"
                   HorizontalOptions="Center" Margin="0,40" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:OwnerApplication">
                <Border Margin="0,0,0,12" Padding="14">
                    <VerticalStackLayout Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding BusinessName}" FontAttributes="Bold" FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Border Grid.Column="1" StrokeThickness="0" Padding="8,3"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{Binding StatusBackColor}">
                                <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{Binding StatusColor}" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding UserName, StringFormat='👤 {0}'}" />
                        <Label Text="{Binding Email}" Style="{StaticResource SubLabel}" />
                        <Label Text="{Binding Phone, StringFormat='📞 {0}'}" />
                        <Label Text="{Binding Address, StringFormat='📍 {0}'}" />
                        <Label Text="{Binding Note}" Style="{StaticResource SubLabel}"
                               IsVisible="{Binding HasNote}" />
                        <Label Text="{Binding DateText}" Style="{StaticResource SubLabel}" FontSize="12" />
                        <Label Text="{Binding AdminNote, StringFormat='Lý do: {0}'}"
                               TextColor="{StaticResource Danger}" FontSize="13"
                               IsVisible="{Binding HasAdminNote}" />
                        <HorizontalStackLayout Spacing="8" Margin="0,8,0,0" IsVisible="{Binding CanReview}">
                            <Button Text="Duyệt" Style="{StaticResource SmallButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminApplicationsViewModel}}, Path=ApproveCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Từ chối" Style="{StaticResource SmallDangerButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminApplicationsViewModel}}, Path=RejectCommand}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>