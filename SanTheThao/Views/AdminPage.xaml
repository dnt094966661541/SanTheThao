<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             x:Class="SanTheThao.Views.AdminPage"
             x:DataType="vm:AdminViewModel"
             Title="Quản trị">

    <CollectionView ItemsSource="{Binding Users}" Margin="16,0">

        <CollectionView.Header>
            <VerticalStackLayout x:DataType="vm:AdminViewModel" Spacing="12" Padding="0,14,0,8">

                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">

                    <Border Grid.Row="0" Grid.Column="0" Padding="10" StrokeThickness="0"
                            BackgroundColor="{StaticResource Accent}">
                        <VerticalStackLayout>
                            <Label Text="{Binding CustomersText}" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Green}" HorizontalOptions="Center" />
                            <Label Text="Khách hàng" Style="{StaticResource SubLabel}" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" Padding="10" StrokeThickness="0"
                            BackgroundColor="{StaticResource Accent}">
                        <VerticalStackLayout>
                            <Label Text="{Binding OwnersText}" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Green}" HorizontalOptions="Center" />
                            <Label Text="Chủ sân" Style="{StaticResource SubLabel}" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Padding="10" StrokeThickness="0"
                            BackgroundColor="{StaticResource Accent}">
                        <VerticalStackLayout>
                            <Label Text="{Binding VenuesText}" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Green}" HorizontalOptions="Center" />
                            <Label Text="Sân" Style="{StaticResource SubLabel}" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" Padding="10" StrokeThickness="0"
                            BackgroundColor="{StaticResource Accent}">
                        <VerticalStackLayout>
                            <Label Text="{Binding BookingsText}" FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Green}" HorizontalOptions="Center" />
                            <Label Text="Đơn đang có" Style="{StaticResource SubLabel}" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="10" StrokeThickness="0"
                            BackgroundColor="{StaticResource Green}">
                        <VerticalStackLayout>
                            <Label Text="{Binding RevenueText}" FontSize="22" FontAttributes="Bold"
                                   TextColor="White" HorizontalOptions="Center" />
                            <Label Text="Tổng doanh thu" TextColor="#DDF2E3" FontSize="12"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Button Text="Hồ sơ đăng ký chủ sân" Command="{Binding ApplicationsCommand}" />
                <Button Text="Xem tất cả đơn đặt" Style="{StaticResource OutlineButton}"
                        Command="{Binding AllBookingsCommand}" />

                <Label Text="Tài khoản" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:AdminUser">
                <Border Margin="0,0,0,10" Padding="12">
                    <VerticalStackLayout Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="15"
                                   LineBreakMode="TailTruncation" />
                            <Border Grid.Column="1" StrokeThickness="0" Padding="8,3"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{Binding StatusBackColor}">
                                <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{Binding StatusColor}" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding Email}" Style="{StaticResource SubLabel}" />
                        <Border Style="{StaticResource Badge}">
                            <Label Text="{Binding RoleText}" FontSize="11"
                                   TextColor="{StaticResource Green}" />
                        </Border>
                        <HorizontalStackLayout Spacing="8" Margin="0,6,0,0" IsVisible="{Binding CanManage}">
                            <Button Text="{Binding LockButtonText}" Style="{StaticResource SmallDangerButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=ToggleLockCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Đổi vai trò" Style="{StaticResource SmallButton}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminViewModel}}, Path=ChangeRoleCommand}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>