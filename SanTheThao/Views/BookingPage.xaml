<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             xmlns:controls="clr-namespace:SanTheThao.Controls"
             x:Class="SanTheThao.Views.BookingPage"
             x:DataType="vm:VenueDetailViewModel"
             Title="Đặt sân">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="12">

                <!-- Sân đang chọn -->
                <Border Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:VenuePhoto ImageUrl="{Binding Venue.FullImageUrl}" Icon="{Binding Venue.Icon}"
                                             WidthRequest="56" HeightRequest="56" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Venue.Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Venue.PricePerHour, StringFormat='Từ {0:N0} đ/giờ'}"
                                   Style="{StaticResource PriceLabel}" FontSize="14" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Chọn ngày -->
                <Label Text="Chọn ngày" Style="{StaticResource SectionLabel}" />
                <Border Style="{StaticResource InputBox}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="📅" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding SelectedDate}"
                                    MinimumDate="{Binding MinDate}" MaximumDate="{Binding MaxDate}"
                                    Format="dd/MM/yyyy" />
                    </Grid>
                </Border>

                <!-- Chọn khung giờ -->
                <Label Text="Chọn khung giờ" Style="{StaticResource SectionLabel}" Margin="0,4,0,0" />
                <Label Text="Trắng: còn trống · Xám: đã đặt hoặc đã qua giờ · Xanh: bạn đang chọn"
                       Style="{StaticResource SubLabel}" FontSize="12" />

                <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Slots}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:TimeSlot">
                            <Border FlexLayout.Basis="48%" Margin="3" Padding="0,10"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{Binding BackColor}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Text}" TextColor="{Binding TextColor}"
                                           FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="{Binding PriceText}" TextColor="{Binding SubTextColor}"
                                           FontSize="12" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VenueDetailViewModel}}, Path=ToggleSlotCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Mã giảm giá -->
                <Label Text="Mã giảm giá" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Style="{StaticResource InputBox}">
                        <Entry Text="{Binding PromoCode}" Placeholder="Ví dụ: WELCOME10" />
                    </Border>
                    <Button Grid.Column="1" Text="Áp dụng" HeightRequest="50"
                            Command="{Binding ApplyPromoCommand}" />
                </Grid>
                <Label Text="{Binding PromoMessage}" Style="{StaticResource SubLabel}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Thanh tổng tiền -->
        <Border Grid.Row="1" Padding="16" StrokeShape="RoundRectangle 0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Tổng tiền" Style="{StaticResource SubLabel}" FontSize="12" />
                    <Label Text="{Binding TotalText}" Style="{StaticResource PriceLabel}" FontSize="17" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Đặt sân" WidthRequest="130" Command="{Binding BookCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>