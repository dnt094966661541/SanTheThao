<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             x:Class="SanTheThao.Views.ChangePasswordPage"
             x:DataType="vm:ChangePasswordViewModel"
             Title="Đổi mật khẩu">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8">

            <Label Text="Mật khẩu hiện tại" FontAttributes="Bold" />
            <Border Style="{StaticResource InputBox}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Entry Placeholder="Nhập mật khẩu hiện tại"
                           IsPassword="{Binding HidePassword}" Text="{Binding CurrentPassword}" />
                    <Label Grid.Column="1" Text="{Binding EyeText}" FontSize="18" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>

            <Label Text="Mật khẩu mới" FontAttributes="Bold" Margin="0,8,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Entry Placeholder="Nhập mật khẩu mới"
                       IsPassword="{Binding HidePassword}" Text="{Binding NewPassword}" />
            </Border>

            <Label Text="Nhập lại mật khẩu mới" FontAttributes="Bold" Margin="0,8,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Entry Placeholder="Nhập lại mật khẩu mới"
                       IsPassword="{Binding HidePassword}" Text="{Binding ConfirmPassword}" />
            </Border>

            <Label Text="{Binding ErrorText}" TextColor="{StaticResource Danger}" FontSize="13" />

            <Button Text="Đổi mật khẩu" Command="{Binding SaveCommand}" Margin="0,8,0,0" />

            <Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" Padding="14" Margin="0,8,0,0">
                <Label Text="ℹ️  Mật khẩu cần có ít nhất 6 ký tự." Style="{StaticResource SubLabel}" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>