<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             xmlns:controls="clr-namespace:SanTheThao.Controls"
             x:Class="SanTheThao.Views.HistoryPage"
             x:DataType="vm:HistoryViewModel"
             Title="Lịch sử đặt sân">

    <Grid RowDefinitions="Auto,*" Padding="16,12,16,0" RowSpacing="12">

        <!-- Bộ lọc -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Filters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SportChip">
                        <Border Padding="16,8" StrokeShape="RoundRectangle 20"
                                BackgroundColor="{StaticResource CardWhite}">
                            <Label Text="{Binding Name}" FontSize="14">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Green}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=SelectFilterCommand}"
                                    CommandParameter="{Binding Name}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Bookings}">
                <CollectionView.EmptyView>
                    <Label Text="Chưa có đơn nào ở mục này." Style="{StaticResource SubLabel}"
                           HorizontalOptions="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Booking">
                        <Border Margin="0,0,0,12" Padding="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <controls:VenuePhoto ImageUrl="{Binding FullImageUrl}" Icon="{Binding Icon}"
                                                     WidthRequest="64" HeightRequest="64" VerticalOptions="Start" />

                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding VenueName}" FontAttributes="Bold" FontSize="16"
                                               LineBreakMode="TailTruncation" />
                                        <Border Grid.Column="1" StrokeThickness="0" Padding="8,3"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{Binding StatusBackColor}">
                                            <Label Text="{Binding StatusLabel}" FontSize="11"
                                                   FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding Date, StringFormat='📅 {0:dd/MM/yyyy}'}"
                                           Style="{StaticResource SubLabel}" />
                                    <Label Text="{Binding HoursText, StringFormat='🕒 {0}'}"
                                           Style="{StaticResource SubLabel}" />
                                    <Label Text="{Binding TotalPrice, StringFormat='{0:N0} đ'}"
                                           Style="{StaticResource PriceLabel}" FontSize="17" />
                                    <Label Text="{Binding DiscountText}" Style="{StaticResource SubLabel}"
                                           FontSize="12" IsVisible="{Binding HasDiscount}" />
                                    <Label Text="{Binding Code, StringFormat='Mã đơn: {0}'}"
                                           Style="{StaticResource SubLabel}" FontSize="12" />

                                    <FlexLayout Wrap="Wrap" Margin="0,6,0,0">
                                        <Button Text="Mã QR" Style="{StaticResource SmallButton}" Margin="0,0,8,6"
                                                IsVisible="{Binding CanShowQr}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=ShowQrCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Chia tiền" Style="{StaticResource SmallButton}" Margin="0,0,8,6"
                                                IsVisible="{Binding CanSplit}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=SplitCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Đánh giá" Style="{StaticResource SmallButton}" Margin="0,0,8,6"
                                                IsVisible="{Binding CanReview}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=ReviewCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Hủy đơn" Style="{StaticResource SmallDangerButton}" Margin="0,0,8,6"
                                                IsVisible="{Binding CanCancel}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HistoryViewModel}}, Path=CancelCommand}"
                                                CommandParameter="{Binding .}" />
                                    </FlexLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>