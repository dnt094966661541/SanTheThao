<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             x:Class="SanTheThao.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Thông báo">

    <Grid RowDefinitions="Auto,*" Padding="16,12,16,0" RowSpacing="10">

        <Button Text="Đánh dấu đã đọc tất cả" Style="{StaticResource SmallButton}"
                HorizontalOptions="End" Command="{Binding MarkAllCommand}" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Items}">
                <CollectionView.EmptyView>
                    <Label Text="Chưa có thông báo nào." Style="{StaticResource SubLabel}"
                           HorizontalOptions="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:NotificationItem">
                        <Border Margin="0,0,0,10" Padding="12" BackgroundColor="{Binding BackColor}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Icon}" FontSize="26" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Title}" FontAttributes="{Binding TitleStyle}" FontSize="15" />
                                    <Label Text="{Binding Body}" Style="{StaticResource SubLabel}" />
                                    <Label Text="{Binding TimeText}" Style="{StaticResource SubLabel}" FontSize="11" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" WidthRequest="10" HeightRequest="10" Padding="0"
                                        StrokeThickness="0" StrokeShape="Ellipse" VerticalOptions="Start"
                                        BackgroundColor="{StaticResource Green}" IsVisible="{Binding IsUnread}" />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>