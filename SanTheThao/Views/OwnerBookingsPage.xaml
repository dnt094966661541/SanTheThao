<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             x:Class="SanTheThao.Views.OwnerBookingsPage"
             x:DataType="vm:OwnerBookingsViewModel"
             Title="Đơn đặt sân">

    <CollectionView ItemsSource="{Binding Bookings}" Margin="16,12,16,0">
        <CollectionView.EmptyView>
            <Label Text="Chưa có đơn đặt nào." Style="{StaticResource SubLabel}"
                   HorizontalOptions="Center" Margin="0,40" />
        </CollectionView.EmptyView>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Booking">
                <Border Margin="0,0,0,12" Padding="12">
                    <VerticalStackLayout Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding VenueName}" FontAttributes="Bold" FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Border Grid.Column="1" StrokeThickness="0" Padding="8,3"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{Binding StatusBackColor}">
                                <Label Text="{Binding StatusLabel}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{Binding StatusColor}" />
                            </Border>
                        </Grid>
                        <Label Text="{Binding CustomerName, StringFormat='👤 {0}'}" FontSize="14" />
                        <Label Text="{Binding Date, StringFormat='📅 {0:dd/MM/yyyy}'}"
                               Style="{StaticResource SubLabel}" />
                        <Label Text="{Binding HoursText, StringFormat='🕒 {0}'}"
                               Style="{StaticResource SubLabel}" />
                        <Label Text="{Binding TotalPrice, StringFormat='{0:N0} đ'}"
                               Style="{StaticResource PriceLabel}" FontSize="17" />
                        <Label Text="{Binding DiscountText}" Style="{StaticResource SubLabel}"
                               FontSize="12" IsVisible="{Binding HasDiscount}" />
                        <Label Text="✅ Khách đã check-in" TextColor="{StaticResource Green}" FontSize="13"
                               IsVisible="{Binding IsCheckedIn}" />
                        <Label Text="{Binding Code, StringFormat='Mã đơn: {0}'}"
                               Style="{StaticResource SubLabel}" FontSize="12" />
                        <Button Text="Hủy đơn" Style="{StaticResource SmallDangerButton}"
                                HorizontalOptions="Start" Margin="0,6,0,0"
                                IsVisible="{Binding CanCancel}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OwnerBookingsViewModel}}, Path=CancelCommand}"
                                CommandParameter="{Binding .}" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>