<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             xmlns:controls="clr-namespace:SanTheThao.Controls"
             x:Class="SanTheThao.Views.OwnerHomePage"
             x:DataType="vm:OwnerHomeViewModel"
             Title="Quản lý sân">

    <CollectionView ItemsSource="{Binding Venues}" Margin="16,0">

        <CollectionView.Header>
            <VerticalStackLayout x:DataType="vm:OwnerHomeViewModel" Spacing="12" Padding="0,14,0,8">

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                    <Border Grid.Row="0" Grid.Column="0" HeightRequest="84" Padding="8" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#1B8A3A">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="➕" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Thêm sân" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="1" HeightRequest="84" Padding="8" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#2F80ED">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="📷" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Quét QR check-in" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ScanCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="0" HeightRequest="84" Padding="8" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#F2994A">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="⌨️" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Nhập mã check-in" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CheckInCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" HeightRequest="84" Padding="8" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#7B61FF">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="📄" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Đơn đặt" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BookingsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" HeightRequest="84" Padding="8" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#14B8A6">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="📊" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Doanh thu" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RevenueCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="1" HeightRequest="84" Padding="8" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#EF5B6B">
                        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
                            <Label Text="🏷️" FontSize="26" HorizontalOptions="Center" />
                            <Label Text="Mã giảm giá" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PromosCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Label Text="Danh sách sân" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <Label Text="Bạn chưa có sân nào. Bấm &quot;Thêm sân&quot; để bắt đầu."
                   Style="{StaticResource SubLabel}" HorizontalOptions="Center" Margin="0,30" />
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Venue">
                <Border Margin="0,0,0,12" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <controls:VenuePhoto ImageUrl="{Binding FullImageUrl}" Icon="{Binding Icon}"
                                             WidthRequest="72" HeightRequest="72" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding District, StringFormat='📍 {0}'}"
                                   Style="{StaticResource SubLabel}" />
                            <Label Text="{Binding PricePerHour, StringFormat='{0:N0} đ/giờ'}"
                                   Style="{StaticResource PriceLabel}" FontSize="15" />
                            <Border StrokeThickness="0" Padding="8,3" StrokeShape="RoundRectangle 10"
                                    HorizontalOptions="Start" BackgroundColor="{Binding StatusBackColor}">
                                <Label Text="{Binding StatusText}" FontSize="11" FontAttributes="Bold"
                                       TextColor="{Binding StatusColor}" />
                            </Border>
                            <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                <Button Text="Sửa" Style="{StaticResource SmallButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OwnerHomeViewModel}}, Path=EditCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Text="{Binding ToggleText}" Style="{StaticResource SmallDangerButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OwnerHomeViewModel}}, Path=ToggleCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>