<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             x:Class="SanTheThao.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Hồ sơ cá nhân">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Border WidthRequest="96" HeightRequest="96" Padding="0" StrokeThickness="0"
                    StrokeShape="Ellipse" BackgroundColor="{StaticResource Accent}"
                    HorizontalOptions="Center" Margin="0,8,0,0">
                <Label Text="{Binding Initial}" FontSize="40" FontAttributes="Bold"
                       TextColor="{StaticResource Green}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="{Binding FullName}" Style="{StaticResource TitleLabel}" HorizontalOptions="Center" />
            <Label Text="{Binding Email}" Style="{StaticResource SubLabel}" HorizontalOptions="Center" />
            <Border Style="{StaticResource Badge}" HorizontalOptions="Center">
                <Label Text="{Binding RoleText}" FontSize="12" FontAttributes="Bold"
                       TextColor="{StaticResource Green}" />
            </Border>

            <!-- Đăng ký làm chủ sân (chỉ khách hàng thấy) -->
            <Border Padding="14" Margin="0,8,0,0" IsVisible="{Binding ShowOwnerSection}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Bạn có sân thể thao?" Style="{StaticResource SectionLabel}" />
                    <Label Text="{Binding ApplicationText}" Style="{StaticResource SubLabel}" />
                    <Button Text="Đăng ký làm chủ sân" Command="{Binding ApplyCommand}"
                            IsVisible="{Binding ShowApply}" />
                    <Button Text="Cập nhật quyền chủ sân" Command="{Binding RefreshRoleCommand}"
                            IsVisible="{Binding ShowRefresh}" />
                </VerticalStackLayout>
            </Border>

            <!-- Danh sách chức năng -->
            <Border Padding="0" Margin="0,8,0,0">
                <VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,14">
                        <Label Text="👤" FontSize="18" />
                        <Label Grid.Column="1" Text="Thông tin cá nhân" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#9CA3AF" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditNameCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E5E7EB" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,14">
                        <Label Text="🔒" FontSize="18" />
                        <Label Grid.Column="1" Text="Đổi mật khẩu" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#9CA3AF" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePasswordCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E5E7EB" />

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,14">
                        <Label Text="📋" FontSize="18" />
                        <Label Grid.Column="1" Text="Lịch sử đặt sân" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#9CA3AF" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoHistoryCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E5E7EB" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,14">
                        <Label Text="🏅" FontSize="18" />
                        <Label Grid.Column="1" Text="Điểm thưởng và hạng thành viên" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#9CA3AF" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoLoyaltyCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E5E7EB" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,14">
                        <Label Text="🔁" FontSize="18" />
                        <Label Grid.Column="1" Text="Đặt sân cố định" FontSize="15" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="›" FontSize="20" TextColor="#9CA3AF" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoRecurringCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <!-- Thêm công tắc Nhắc giờ chơi -->
                    <BoxView HeightRequest="1" Color="#E5E7EB" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="16,10">
                        <Label Text="⏰" FontSize="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Nhắc giờ chơi (trước 1 tiếng)" FontSize="15" VerticalOptions="Center" />
                        <Switch Grid.Column="2" IsToggled="{Binding RemindersEnabled}"
                                OnColor="{StaticResource Green}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button Text="Đăng xuất" Style="{StaticResource DangerButton}"
                    Margin="0,16,0,0" Command="{Binding LogoutCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>