<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             xmlns:controls="clr-namespace:SanTheThao.Controls"
             x:Class="SanTheThao.Views.VenueDetailPage"
             x:DataType="vm:VenueDetailViewModel"
             Title="Chi tiết sân">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Ảnh đại diện (Gradient + Ảnh sân) -->
                <Grid HeightRequest="200">
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#146B2D" Offset="0" />
                                <GradientStop Color="#34B35A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="{Binding Venue.Icon}" FontSize="84"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Image Source="{Binding Venue.FullImageUrl}" Aspect="AspectFill"
                           IsVisible="{Binding Venue.HasImage}" />
                </Grid>

                <VerticalStackLayout Padding="16" Spacing="12">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding Venue.Name}" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{Binding FavoriteText}"
                                Style="{StaticResource SmallButton}"
                                Command="{Binding ToggleFavoriteCommand}" />
                    </Grid>

                    <Label FontSize="14">
                        <Label.Text>
                            <MultiBinding StringFormat="⭐ {0} ({1} đánh giá)">
                                <Binding Path="Venue.Rating" />
                                <Binding Path="Venue.ReviewCount" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>

                    <Label Style="{StaticResource SubLabel}" FontSize="14">
                        <Label.Text>
                            <MultiBinding StringFormat="📍 {0}, {1}">
                                <Binding Path="Venue.Address" />
                                <Binding Path="Venue.District" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>

                    <!-- Bảng giá -->
                    <Label Text="Bảng giá" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
                    <Border Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Giờ thường" />
                                <Label Grid.Column="1" Text="{Binding Venue.PricePerHour, StringFormat='{0:N0} đ/giờ'}"
                                       Style="{StaticResource PriceLabel}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Venue.HasPeak}">
                                <Label Text="{Binding Venue.PeakText}" />
                                <Label Grid.Column="1" Text="{Binding Venue.PeakPricePerHour, StringFormat='{0:N0} đ/giờ'}"
                                       Style="{StaticResource PriceLabel}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Venue.HasWeekend}">
                                <Label Text="Cuối tuần (Thứ bảy, Chủ nhật)" />
                                <Label Grid.Column="1" Text="{Binding Venue.WeekendPricePerHour, StringFormat='{0:N0} đ/giờ'}"
                                       Style="{StaticResource PriceLabel}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Đánh giá -->
                    <Label Text="Đánh giá của khách" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
                    <Label Text="Chưa có đánh giá nào." Style="{StaticResource SubLabel}"
                           IsVisible="{Binding HasNoReviews}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Reviews}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Review">
                                <Border Padding="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="{Binding UserName}" FontAttributes="Bold" />
                                        <Label Text="{Binding StarsText}" FontSize="13" />
                                        <Label Text="{Binding Comment}" IsVisible="{Binding HasComment}" />
                                        <Label Text="{Binding DateText}" Style="{StaticResource SubLabel}" FontSize="11" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Thanh nút dưới -->
        <Border Grid.Row="1" Padding="16" StrokeShape="RoundRectangle 0">
            <Button Text="Chọn giờ và đặt sân" Command="{Binding GoBookCommand}" />
        </Border>
    </Grid>
</ContentPage>