<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SanTheThao.ViewModels"
             xmlns:models="clr-namespace:SanTheThao.Models"
             x:Class="SanTheThao.Views.VenueEditPage"
             x:DataType="vm:VenueEditViewModel"
             Title="{Binding PageTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="6">

            <Label Text="Ảnh sân" Style="{StaticResource SectionLabel}" />
            <Border BackgroundColor="{StaticResource Accent}" StrokeThickness="0" Padding="14"
                    IsVisible="{Binding ShowGalleryHint}">
                <Label Text="Bạn lưu thông tin sân trước, sau đó sẽ thêm được ảnh ở đây."
                       Style="{StaticResource SubLabel}" />
            </Border>
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasGallery}">
                <Label Text="Ảnh chính hiện ở Trang chủ. Các ảnh còn lại khách xem ở trang Chi tiết sân."
                       Style="{StaticResource SubLabel}" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Images}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:VenueImage">
                            <Border Padding="8">
                                <Grid ColumnDefinitions="120,*" ColumnSpacing="12">
                                    <Border HeightRequest="84" Padding="0" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10">
                                        <Image Source="{Binding FullUrl}" Aspect="AspectFill" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Border Style="{StaticResource Badge}" IsVisible="{Binding IsMain}">
                                            <Label Text="Ảnh chính" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource Green}" />
                                        </Border>
                                        <HorizontalStackLayout Spacing="8">
                                            <Button Text="Đặt làm ảnh chính" Style="{StaticResource SmallButton}"
                                                    IsVisible="{Binding CanSetMain}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VenueEditViewModel}}, Path=SetMainCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Text="Xóa" Style="{StaticResource SmallDangerButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:VenueEditViewModel}}, Path=RemoveImageCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="{Binding PhotoCountText}" Style="{StaticResource SubLabel}" />
                <Button Text="➕  Thêm ảnh" Style="{StaticResource OutlineButton}"
                        Command="{Binding AddPhotoCommand}" Margin="0,0,0,12" />
            </VerticalStackLayout>

            <Label Text="Thông tin sân" Style="{StaticResource SectionLabel}" />

            <Label Text="Tên sân" FontAttributes="Bold" Margin="0,6,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding Name}" Placeholder="Ví dụ: Sân cầu lông Thăng Long" />
            </Border>

            <Label Text="Môn thể thao" FontAttributes="Bold" Margin="0,6,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Picker ItemsSource="{Binding Sports}" SelectedItem="{Binding Sport}" />
            </Border>

            <Label Text="Địa chỉ" FontAttributes="Bold" Margin="0,6,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding Address}" />
            </Border>

            <Label Text="Khu vực (quận, huyện)" FontAttributes="Bold" Margin="0,6,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding District}" />
            </Border>

            <Label Text="Bảng giá (đồng/giờ)" Style="{StaticResource SectionLabel}" Margin="0,16,0,0" />

            <Label Text="Giá thường" FontAttributes="Bold" Margin="0,6,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding PriceText}" Keyboard="Numeric" />
            </Border>

            <Label Text="Giá giờ cao điểm (0 = không dùng)" Margin="0,6,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding PeakPriceText}" Keyboard="Numeric" />
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Text="Cao điểm từ (giờ)" />
                    <Border Style="{StaticResource InputBox}">
                        <Entry Text="{Binding PeakStartText}" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="6">
                    <Label Text="Đến trước (giờ)" />
                    <Border Style="{StaticResource InputBox}">
                        <Entry Text="{Binding PeakEndText}" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <Label Text="Giá cuối tuần (0 = không dùng)" Margin="0,6,0,0" />
            <Border Style="{StaticResource InputBox}">
                <Entry Text="{Binding WeekendPriceText}" Keyboard="Numeric" />
            </Border>

            <Label Text="{Binding ErrorText}" TextColor="{StaticResource Danger}" FontSize="13" />

            <Button Text="Lưu sân" Command="{Binding SaveCommand}" Margin="0,8,0,16" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>